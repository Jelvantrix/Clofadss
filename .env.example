# Copy to `.env` and fill in. NEVER commit `.env`.
#
# NOTE: the legacy DEMO_MODE flag and all seeded/demo fixtures were removed.
# The application only ever renders real database content.

# --- Supabase (browser-safe) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server only — never prefix with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Server ---
GEMINI_API_KEY=
TRUST_PROXY=
# Required by GET /api/cron/health. Use a long random value; Vercel Cron sends
# it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Optional salt for hashed IP addresses in security analytics. Use a long
# random value in production; changing it resets the ability to correlate
# hashes across deployments, not the stored events.
SECURITY_HASH_SALT=
